# Copie este arquivo para .env e preencha com seus próprios valores.

# Chave de API do Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ID da planilha do Google Sheets usada como tracking (opcional).
# Encontrado na URL da planilha: docs.google.com/spreadsheets/d/<ESTE_ID>/edit
# Se deixar em branco, o resultado é salvo em tracking/tests_log.csv.
GOOGLE_SHEET_ID=

